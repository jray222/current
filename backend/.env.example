# Copy to backend/.env and adjust. Every setting is optional.

# --- Database ---
# Defaults to SQLite at backend/data/current.db.
# DATABASE_URL=sqlite:////app/backend/data/current.db

# --- App ---
APP_ENV=development
DEBUG=False
# The crawl schedule and dates use this time zone.
# TZ=America/Indiana/Indianapolis

# --- Authentication & Security ---
# Signs sign-ins. Until DATA_KEYS is set and you re-encrypt (Settings -> Server
# keys), it also makes the key that encrypts 2FA secrets and the stored Anthropic
# API key, so changing it then makes those unreadable (Server keys says so). If
# unset, one is generated on first run and saved to backend/data/secret_key.
# Keep a copy in a password manager.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# SECRET_KEY=
# Data encryption keys, comma-separated, newest first (Server keys can make one).
# DATA_KEYS=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_CHALLENGE_EXPIRE_MINUTES=5
# Wrong passwords from devices that never signed in to an account: this many
# within 15 minutes pause sign-in from new devices for this long, doubling each
# time up to a day. Devices that signed in before aren't affected.
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Only enable behind a reverse proxy you control (e.g. Cloudflare): the visitor's
# IP is then read from CF-Connecting-IP / X-Real-IP / X-Forwarded-For, but only
# on requests from Cloudflare's addresses, private/Docker networks, or these:
TRUST_PROXY_HEADERS=False
# TRUSTED_PROXIES=203.0.113.10,198.51.100.0/24

# The address people use to reach Current from the internet (e.g. your Cloudflare
# domain). Invite links are built from it. The owner can also set it in the app.
# PUBLIC_URL=https://current.example.com

# Anyone may sign up (each sign-up creates its own isolated household).
# False = invite-only: after the first account, household admins add members.
ALLOW_REGISTRATION=False

# Must exactly match the origin the frontend is served from (dev server).
FRONTEND_ORIGIN=http://localhost:5173

# --- Current News Crawler, Safe Fetch & Reader Settings ---
# Sent with outbound crawler requests: Current/0.1 (+PUBLIC_URL; CRAWLER_CONTACT)
CRAWLER_CONTACT=https://github.com/jray222/current
RESPECT_ROBOTS=true
CRAWL_DELAY_SECONDS=1.0
MAX_NEW_PER_SOURCE=25
MAX_ARTICLE_PAGES=5
RETENTION_DAYS=14
BROWSER_FETCH=true
# ADBLOCK_EXTRA_HOSTS=custom-ad-domain.com,tracker.net
ALLOW_PRIVATE_SOURCES=false
# ALLOWED_PORTS=80,443,8080
SCHEDULER_ENABLED=true
# IMAGES_DIR=/app/backend/data/images

# --- AI (optional; Current works without a key) ---
# Used for batch categorization when enabled. The owner can also paste the key in
# Settings -> AI, where it is stored encrypted.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
